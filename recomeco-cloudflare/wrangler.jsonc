{
  // O "name" precisa ser IGUAL ao nome do projeto/Worker que você criou no Cloudflare
  "name": "recomeco",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Arquivos do site (pasta public). O Worker decide quem pode ver cada um.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // Banco de dados principal: Durable Object (SQLite), consistente e sem o limite de gravações do KV.
  // Não precisa criar nada à mão: o deploy cria sozinho.
  "durable_objects": {
    "bindings": [ { "name": "BANCO", "class_name": "Banco" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Banco"] }
  ],

  // KV ANTIGO: mantido só para importar automaticamente as contas/dados que já existem.
  // Depois que tudo foi usado/migrado, pode ser removido.
  "kv_namespaces": [
    { "binding": "DB", "id": "b06748d56f694a08b4b4087d56689f33" }
  ]
}
